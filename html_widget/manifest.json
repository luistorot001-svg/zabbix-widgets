{
	"manifest_version": 2.0,
	"id": "html_widget",
	"type": "widget",
	"name": "HTML",
	"namespace": "HtmlWidget",
	"version": "3.0.0",
	"author": "luistorot001-svg",
	"url": "https://github.com/luistorot001-svg/zabbix-widgets",
	"description": "Muestra contenido HTML propio en un dashboard, con color de fondo opcional.",
	"widget": {
		"size": {
			"width": 24,
			"height": 4
		},
		"refresh_rate": 0
	},
	"actions": {
		"widget.html_widget.view": {
			"class": "WidgetView"
		}
	},
	"assets": {
		"css": ["widget.css"]
	}
}
