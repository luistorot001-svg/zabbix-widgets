{
	"manifest_version": 2.0,
	"id": "header_widget",
	"type": "widget",
	"name": "Cabecera",
	"namespace": "HeaderWidget",
	"version": "1.0.0",
	"author": "luistorot001-svg",
	"url": "https://github.com/luistorot001-svg/zabbix-widgets",
	"description": "Cabecera para dashboards: título, subtítulo y logotipo, con colores y alineación configurables.",
	"widget": {
		"js_class": "CWidgetHeader",
		"size": {
			"width": 72,
			"height": 2
		},
		"refresh_rate": 0
	},
	"actions": {
		"widget.header_widget.view": {
			"class": "WidgetView"
		}
	},
	"assets": {
		"js": ["class.widget.js"],
		"css": ["widget.css"]
	}
}
